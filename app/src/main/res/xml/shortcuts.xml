<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutShortLabel="@string/shortcut_note"
        android:shortcutLongLabel="@string/shortcut_note_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.noe.app"
            android:targetClass="com.noe.app.MainActivity">
            <extra
                android:name="noe_action"
                android:value="new_note" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="new_checklist"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_checklist"
        android:shortcutShortLabel="@string/shortcut_checklist"
        android:shortcutLongLabel="@string/shortcut_checklist_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.noe.app"
            android:targetClass="com.noe.app.MainActivity">
            <extra
                android:name="noe_action"
                android:value="new_checklist" />
        </intent>
    </shortcut>
</shortcuts>
